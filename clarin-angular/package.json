    "mat-table-exporter": "^15.0.0",
    "mathjs": "^15.2.0",
    "minimatch": "^10.2.5",
    "moment": "^2.30.1",
    "ng-matero": "^21.0.0",
    "ngx-filesaver": "^21.0.0",
    "ngx-permissions": "^19.0.0",
